diff --git a/Core/RRBox.cpp b/Core/RRBox.cpp
new file mode 100644
index 0000000..ae37f87
--- /dev/null
+++ b/Core/RRBox.cpp
@@ -0,0 +1,923 @@
+#include "Core/RRBox.h"
+#include <algorithm>
+#include <map>
+#include <set>
+#include <string>
+#include "Core/MIPS/MIPS.h"
+#include "Core/MIPS/MIPSTables.h"
+#include "Core/HLE/HLE.h"
+#include "Core/HLE/sceKernelThread.h"
+#include "Core/HLE/sceKernelInterrupt.h"
+#include "Core/CoreTiming.h"
+#include "Core/MemMap.h"
+#include "Core/System.h"
+
+namespace RRBox {
+bool g_tracing = false;
+bool g_reading = false;
+
+struct Frame { u32 func; u32 ra; u32 sp; int thread; u64 call; u64 hash; u64 writes; u32 saved[9]; s64 t0; };
+static std::vector<u8> g_watch;         // one byte per word of the module's .text: watched entry
+static std::vector<std::pair<u32, u32>> g_ranges;   // watched functions: (absolute start, size)
+static std::vector<u8> g_exec;          // one byte per word over [g_clo, g_chi): executed
+static u32 g_clo = 0, g_chi = 0;
+static std::string g_covPath;
+static std::map<std::string, std::map<int, u32>> g_force;  // name -> call index -> forced v0
+static std::map<std::string, int> g_forceSeen;
+static u32 g_base = 0, g_lo = 0, g_hi = 0;
+static std::vector<Frame> g_frames;
+static std::map<u32, u64> g_calls;      // calls seen per function
+static FILE *g_log = nullptr;
+static std::string g_logPath;
+static std::map<std::pair<u32, u64>, s64> g_refCycles;  // (func offset, call) -> retail cycles
+static std::map<std::pair<u32, u64>, s64> g_refEntry;   // (func offset, call) -> retail time at entry
+
+static inline u64 Mix(u64 h, u64 v) { h ^= v + 0x9E3779B97F4A7C15ULL + (h << 6) + (h >> 2); return h * 0xFF51AFD7ED558CCDULL; }
+
+// ---- Per-call lockstep (--rr-lockstep): each real call of a tested function runs the original body,
+// then the candidate's body from the same state, and their outputs are compared; the game then
+// continues with the original's results, so every call is an independent input/output test.
+struct Regs {
+	u32 r[32]; u32 fi[32]; u32 vi[128]; u32 vfpuCtrl[16]; u32 pc, lo, hi, fcr31, fpcond, nextPC; bool inDelaySlot; int llBit;
+	void Save(const MIPSState *m) {
+		memcpy(r, m->r, sizeof(r)); memcpy(fi, m->fi, sizeof(fi)); memcpy(vi, m->vi, sizeof(vi));
+		memcpy(vfpuCtrl, m->vfpuCtrl, sizeof(vfpuCtrl));
+		pc = m->pc; lo = m->lo; hi = m->hi; fcr31 = m->fcr31; fpcond = m->fpcond; nextPC = m->nextPC;
+		inDelaySlot = m->inDelaySlot; llBit = m->llBit;
+	}
+	void Load(MIPSState *m) const {
+		memcpy(m->r, r, sizeof(r)); memcpy(m->fi, fi, sizeof(fi)); memcpy(m->vi, vi, sizeof(vi));
+		memcpy(m->vfpuCtrl, vfpuCtrl, sizeof(vfpuCtrl));
+		m->pc = pc; m->lo = lo; m->hi = hi; m->fcr31 = fcr31; m->fpcond = fpcond; m->nextPC = nextPC;
+		m->inDelaySlot = inDelaySlot; m->llBit = llBit;
+	}
+};
+struct LockFn { u32 size; int rk; std::vector<u8> cand, orig; std::vector<u8> exec; u64 tested = 0, calls = 0; u32 load = 0; };
+static std::vector<std::pair<u32, std::vector<u8>>> g_specData;  // annexed read-only data (DATA lines)
+static std::map<u32, LockFn> g_lockFns;     // absolute entry -> tested function
+static FILE *g_lockLog = nullptr;
+static std::string g_lockCov;
+static u64 g_lockPerFn = ~0ULL;
+struct Lock {
+	int phase = 0;                          // 0 idle, 1 original running, 2 candidate running
+	u32 func = 0, ra = 0, sp = 0; int thread = 0; u64 call = 0;
+	Regs entry, after;
+	std::map<u32, u8> old1, old2;            // first-touched byte -> value before the run
+	std::map<u32, u8> fin1;                 // original's final bytes
+	u64 n1 = 0, n2 = 0;                     // instructions run
+	int downcount = 0;
+	std::map<u32, u8> in;                   // recording: bytes read before being written (inputs)
+	u32 stkLo = 0, stkHi = 0;               // the calling thread's stack
+	bool replay = false;                    // replaying a case: reads outside `in` are counted
+	u64 unrec = 0; u32 unrecFirst = 0;
+};
+static Lock g_lk;
+// Replay journals: one bit per byte over 0x04000000-0x0C000000 (VRAM and RAM), so membership is
+// constant time; addresses outside fall back to nothing (never written by game code).
+struct ByteSet {
+	static const u32 lo = 0x04000000, hi = 0x0C000000;
+	std::vector<u64> bits;
+	ByteSet() : bits((hi - lo) / 64, 0) {}
+	bool has(u32 a) const { return a >= lo && a < hi && (bits[(a - lo) >> 6] >> ((a - lo) & 63) & 1); }
+	void set(u32 a) { if (a >= lo && a < hi) bits[(a - lo) >> 6] |= 1ULL << ((a - lo) & 63); }
+	void reset(u32 a) { if (a >= lo && a < hi) bits[(a - lo) >> 6] &= ~(1ULL << ((a - lo) & 63)); }
+};
+static ByteSet *g_w2 = nullptr, *g_inset = nullptr;     // replay: written by the candidate; recorded inputs
+static std::vector<std::pair<u32, u8>> g_old2v;         // replay: (byte, value before the candidate wrote it)
+static inline u8 Peek(u32 a) { return Memory::IsValidAddress(a) ? *Memory::GetPointerUnchecked(a) : 0; }
+static inline u32 Peek32(u32 a) { u32 v = 0; if (Memory::IsValidRange(a, 4)) memcpy(&v, Memory::GetPointerUnchecked(a), 4); return v; }
+static inline void Poke(u32 a, u8 v) { if (Memory::IsValidAddress(a)) *Memory::GetPointerWriteUnchecked(a) = v; }
+// recording
+static std::string g_recDir;
+static u64 g_recPerFn = 200;
+static std::map<u32, u64> g_recCount;
+static std::map<u32, std::set<u64>> g_recSeen;
+
+static void LockLog(const char *verdict, const char *why) {
+	if (!g_lockLog) return;
+	fprintf(g_lockLog, "%s %06x %llu %s\n", verdict, g_lk.func - g_base, (unsigned long long)g_lk.call, why);
+	if (verdict[0] != 'P') fflush(g_lockLog);  // a crash later must not lose the line that explains it
+}
+
+static void PutBytes(u32 a, const std::vector<u8> &b) {
+	memcpy(Memory::GetPointerWriteUnchecked(a), b.data(), b.size());
+	currentMIPS->InvalidateICache(a, (int)b.size());
+}
+
+static std::vector<u8> Hex(const char *h, size_t n) {
+	std::vector<u8> v;
+	v.reserve(n / 2);
+	for (size_t k = 0; k + 1 < n; k += 2) {
+		auto d = [](char c) { return c <= '9' ? c - '0' : (c | 32) - 'a' + 10; };
+		v.push_back((u8)(d(h[k]) << 4 | d(h[k + 1])));
+	}
+	return v;
+}
+
+// Spec lines: "OFFSET SLOTSIZE RETKIND HEX [LOAD]" (HEX "-": the slot's own bytes) and
+// "DATA ADDR HEX" (read-only data the bodies refer to, written before anything runs).
+static void ParseSpec(const char *spec, u32 moduleBase) {
+	g_base = moduleBase;
+	FILE *f = fopen(spec, "r");
+	if (!f) { fprintf(stderr, "rrbox: cannot read %s\n", spec); exit(3); }
+	char *line = nullptr; size_t cap = 0; ssize_t n;
+	while ((n = getline(&line, &cap, f)) > 0) {
+		if (line[0] == '#') continue;
+		char *tok[6]; int nt = 0;
+		for (char *t = strtok(line, " \n"); t && nt < 6; t = strtok(nullptr, " \n")) tok[nt++] = t;
+		if (nt == 3 && !strcmp(tok[0], "DATA")) {
+			g_specData.push_back({(u32)strtoul(tok[1], nullptr, 16), Hex(tok[2], strlen(tok[2]))});
+			continue;
+		}
+		if (nt < 4) continue;
+		u32 a = (u32)strtoul(tok[0], nullptr, 16);
+		LockFn fn;
+		fn.size = (u32)strtoul(tok[1], nullptr, 10);
+		const char *rk = tok[2];
+		fn.rk = !strcmp(rk, "void") ? 0 : !strcmp(rk, "int") ? 1 : !strcmp(rk, "wide") ? 2 : 3;
+		if (strcmp(tok[3], "-")) fn.cand = Hex(tok[3], strlen(tok[3]));
+		fn.load = nt >= 5 ? (u32)strtoul(tok[4], nullptr, 16) : moduleBase + a;
+		fn.exec.assign((fn.cand.empty() ? fn.size : fn.cand.size()) / 4, 0);
+		g_lockFns[moduleBase + a] = fn;
+	}
+	free(line);
+	fclose(f);
+}
+
+void LoadLockstep(const char *spec, const char *log, const char *cov, long long perFn, u32 moduleBase) {
+	ParseSpec(spec, moduleBase);
+	g_lockLog = fopen(log, "w");
+	g_lockCov = cov;
+	if (perFn > 0) g_lockPerFn = (u64)perFn;
+}
+
+// Undo the running side's writes, put the original body back, and resume as the original left
+// things: its memory, its registers, and the time it took (the candidate's run takes none).
+static void LockFinish(const char *verdict, const char *why) {
+	for (auto &o : g_lk.old2) *Memory::GetPointerWriteUnchecked(o.first) = o.second;
+	LockFn &fn = g_lockFns[g_lk.func];
+	PutBytes(g_lk.func, fn.orig);
+	for (auto &o : g_lk.fin1) *Memory::GetPointerWriteUnchecked(o.first) = o.second;
+	g_lk.after.Load(currentMIPS);
+	currentMIPS->downcount = g_lk.downcount;
+	LockLog(verdict, why);
+	g_lk.phase = 0;
+	g_lk.old1.clear(); g_lk.old2.clear(); g_lk.fin1.clear();
+	g_tracing = !g_frames.empty();
+}
+
+// Outputs of a run: bytes it changed outside its own stack frame (below the entry sp on the
+// calling thread's stack is its frame and its callees', dead after the return).
+static bool Outside(u32 a) {
+	bool stack = a >= g_lk.stkLo && a < g_lk.stkHi;
+	return !stack || a >= g_lk.sp;
+}
+
+// ---- Case recording, nested: every call of a recorded function is its own case, also when it runs
+// inside another recorded call. Recording never changes execution, so each open call keeps its own
+// journal: reads before its own writes are its inputs, its writes outside its frame its outputs.
+// System functions with no effect on memory and no thread switch: a recorded call may make them.
+// Each one's result is kept in the case and given back to the candidate in replay, after its
+// name and the arguments it takes are checked.
+struct SysFn { const char *name; int nargs; };
+static const SysFn g_pureSys[] = {
+	{"sceKernelCpuSuspendIntr", 0}, {"sceKernelCpuResumeIntr", 1}, {"sceKernelCpuResumeIntrWithSync", 1},
+	{"sceKernelGetSystemTimeLow", 0}, {"sceKernelGetThreadId", 0}, {"sceKernelGetThreadCurrentPriority", 0},
+	{"sceGeEdramGetAddr", 0}, {"sceKernelDcacheWritebackRange", 2}, {"sceKernelDcacheWritebackInvalidateRange", 2},
+	{"sceKernelDcacheWritebackAll", 0}, {"sceKernelDcacheWritebackInvalidateAll", 0},
+};
+static int PureSys(const char *name) {
+	for (auto &f : g_pureSys) if (!strcmp(f.name, name)) return f.nargs;
+	return -1;
+}
+struct Sys { char name[48]; u32 a[4]; u32 v0, v1; };
+struct Rec {
+	u32 func, ra, sp, stkLo, stkHi; int thread; u64 call;
+	Regs entry;
+	std::map<u32, u8> in, old1;
+	std::vector<u8> ran;                     // words of its own body executed in this call
+	std::vector<Sys> sys;                    // allowed system calls made, in order
+	u64 steps = 0;                           // instructions the call ran (callees included)
+};
+static Sys g_pendingSys;
+static bool g_pending = false;
+static std::vector<Rec> g_recs;
+static std::map<u32, std::vector<u8>> g_recRan;  // words of each body run by the cases kept so far
+
+static void WriteCase(const Rec &r, MIPSState *m) {
+	u32 off = r.func - g_base;
+	Regs after; after.Save(m);
+	std::vector<std::pair<u32, u8>> in(r.in.begin(), r.in.end()), out;
+	for (auto &o : r.old1) {
+		bool stack = o.first >= r.stkLo && o.first < r.stkHi;
+		if (!stack || o.first >= r.sp)
+			out.push_back({o.first, Peek(o.first)});
+	}
+	u64 h = 0x51ED270B27D2A3C1ULL;
+	for (u32 v : r.entry.r) h = Mix(h, v);
+	for (u32 v : r.entry.fi) h = Mix(h, v);
+	for (u32 v : r.entry.vi) h = Mix(h, v);
+	for (auto &x : in) h = Mix(Mix(h, x.first), x.second);
+	if (!g_recSeen[off].insert(h).second) return;
+	// keep the case if it runs code no kept case has run (so the cases cover every path the script
+	// reaches), and a few ordinary ones besides, up to the cap
+	std::vector<u8> &kept = g_recRan[off];
+	if (kept.size() < r.ran.size()) kept.resize(r.ran.size(), 0);
+	bool novel = false;
+	for (size_t k = 0; k < r.ran.size(); k++)
+		if (r.ran[k] && !kept[k]) { novel = true; kept[k] = 1; }
+	if (!novel && (g_recCount[off] >= 50 || g_recCount[off] >= g_recPerFn)) return;
+	g_recCount[off]++;
+	char path[600];
+	snprintf(path, sizeof(path), "%s/%06x.cases", g_recDir.c_str(), off);
+	if (FILE *f = fopen(path, "ab")) {
+		u32 n;
+		fwrite("RRC3", 1, 4, f);
+		fwrite(&off, 4, 1, f); fwrite(&r.call, 8, 1, f);
+		fwrite(&r.sp, 4, 1, f); fwrite(&r.stkLo, 4, 1, f); fwrite(&r.stkHi, 4, 1, f);
+		fwrite(&r.entry, sizeof(Regs), 1, f); fwrite(&after, sizeof(Regs), 1, f);
+		for (auto *v : {&in, &out}) {
+			n = (u32)v->size(); fwrite(&n, 4, 1, f);
+			for (auto &x : *v) { fwrite(&x.first, 4, 1, f); fwrite(&x.second, 1, 1, f); }
+		}
+		n = (u32)r.sys.size(); fwrite(&n, 4, 1, f);
+		if (n) fwrite(r.sys.data(), sizeof(Sys), n, f);
+		fwrite(&r.steps, 8, 1, f);
+		fclose(f);
+	}
+	if (g_lockLog) fprintf(g_lockLog, "CASE %06x %llu\n", off, (unsigned long long)r.call);
+}
+
+static void RecPC(u32 pc) {
+	MIPSState *m = currentMIPS;
+	if (!g_recs.empty()) {
+		int t = __KernelGetCurThread();
+		const char *why = nullptr;
+		if (t != g_recs.back().thread) why = "thread switch inside the call";
+		else if (__IsInInterrupt()) why = "interrupt inside the call";
+		// returns, innermost first
+		while (!g_recs.empty() && !why) {
+			Rec &r = g_recs.back();
+			if (pc == r.ra && m->r[MIPS_REG_SP] == r.sp && t == r.thread) { WriteCase(r, m); g_recs.pop_back(); }
+			else break;
+		}
+		if (!why && !g_recs.empty() && (Peek32(pc) & 0xFC00003F) == 0x0000000C) {
+			const HLEFunction *info = GetSyscallFuncPointer(MIPSOpcode(Peek32(pc)));
+			if (info && info->name && PureSys(info->name) >= 0) {
+				// allowed: its result is recorded when it returns (OnSyscallReturn)
+				memset(&g_pendingSys, 0, sizeof(g_pendingSys));
+				snprintf(g_pendingSys.name, sizeof(g_pendingSys.name), "%s", info->name);
+				for (int k = 0; k < 4; k++) g_pendingSys.a[k] = m->r[4 + k];
+				g_pending = true;
+			} else {
+				static char w[96];
+				snprintf(w, sizeof(w), "system call inside the call (%s)", info && info->name ? info->name : "?");
+				why = w;
+			}
+		}
+		if (!why)
+			for (auto &r : g_recs) {
+				r.steps++;
+				if (pc >= r.func && pc < r.func + 4 * r.ran.size()) r.ran[(pc - r.func) / 4] = 1;
+			}
+		if (why) {
+			// every open call contains it: none of them can be replayed
+			if (g_lockLog)
+				for (auto &r : g_recs) fprintf(g_lockLog, "SKIP %06x %llu %s\n", r.func - g_base, (unsigned long long)r.call, why);
+			g_recs.clear();
+		}
+	}
+	auto it = g_lockFns.find(pc);
+	if (it != g_lockFns.end() && !m->inDelaySlot) {
+		u64 call = it->second.calls++;
+		if (g_recCount[pc - g_base] < g_recPerFn) {
+			Rec r;
+			r.ran.assign(it->second.size / 4, 0);
+			r.ran[0] = 1;
+			r.func = pc; r.ra = m->r[MIPS_REG_RA]; r.sp = m->r[MIPS_REG_SP];
+			r.stkLo = __KernelGetCurThreadStackStart(); r.stkHi = __KernelGetCurThreadStack();
+			r.thread = __KernelGetCurThread(); r.call = call;
+			r.entry.Save(m);
+			g_recs.push_back(std::move(r));
+		}
+	}
+	g_tracing = g_reading = !g_recs.empty();
+}
+
+// The original returned: write the case (inputs, outputs, registers) and carry on as retail.
+static void RecordCase(MIPSState *m) {
+	g_reading = false;
+	LockFn &fn = g_lockFns[g_lk.func];
+	u32 off = g_lk.func - g_base;
+	g_lk.after.Save(m);
+	std::vector<std::pair<u32, u8>> in(g_lk.in.begin(), g_lk.in.end()), out;
+	// every byte written outside the frame, with its final value: a byte rewritten with the value it
+	// had is an output too (its entry value is not otherwise recorded unless it was read)
+	for (auto &o : g_lk.old1)
+		if (Outside(o.first))
+			out.push_back({o.first, Peek(o.first)});
+	// identical inputs give identical outputs: keep one case per distinct input
+	u64 h = 0x51ED270B27D2A3C1ULL;
+	for (u32 v : g_lk.entry.r) h = Mix(h, v);
+	for (u32 v : g_lk.entry.fi) h = Mix(h, v);
+	for (u32 v : g_lk.entry.vi) h = Mix(h, v);
+	for (auto &x : in) h = Mix(Mix(h, x.first), x.second);
+	if (g_recSeen[off].insert(h).second && g_recCount[off] < g_recPerFn) {
+		g_recCount[off]++;
+		char path[600];
+		snprintf(path, sizeof(path), "%s/%06x.cases", g_recDir.c_str(), off);
+		if (FILE *f = fopen(path, "ab")) {
+			u32 n;
+			fwrite("RRC1", 1, 4, f);
+			fwrite(&off, 4, 1, f); fwrite(&g_lk.call, 8, 1, f);
+			fwrite(&g_lk.sp, 4, 1, f); fwrite(&g_lk.stkLo, 4, 1, f); fwrite(&g_lk.stkHi, 4, 1, f);
+			fwrite(&g_lk.entry, sizeof(Regs), 1, f); fwrite(&g_lk.after, sizeof(Regs), 1, f);
+			for (auto *v : {&in, &out}) {
+				n = (u32)v->size(); fwrite(&n, 4, 1, f);
+				for (auto &x : *v) { fwrite(&x.first, 4, 1, f); fwrite(&x.second, 1, 1, f); }
+			}
+			fclose(f);
+		}
+		LockLog("CASE", "-");
+	}
+	(void)fn;
+	g_lk.phase = 0;
+	g_lk.old1.clear(); g_lk.in.clear();
+	g_tracing = !g_frames.empty();
+}
+
+static bool LockPC(u32 pc) {
+	MIPSState *m = currentMIPS;
+	if (g_lk.phase == 0) {
+		auto it = g_lockFns.find(pc);
+		if (it == g_lockFns.end() || m->inDelaySlot) return false;
+		LockFn &fn = it->second;
+		u64 call = fn.calls++;
+		if (fn.tested >= g_lockPerFn) return false;
+		if (fn.orig.empty()) {
+			fn.orig.resize(fn.size);
+			memcpy(fn.orig.data(), Memory::GetPointerUnchecked(pc), fn.size);
+		}
+		g_lk.phase = 1;
+		g_lk.func = pc; g_lk.ra = m->r[MIPS_REG_RA]; g_lk.sp = m->r[MIPS_REG_SP];
+		g_lk.thread = __KernelGetCurThread(); g_lk.call = call;
+		g_lk.entry.Save(m);
+		g_lk.n1 = g_lk.n2 = 0;
+		g_lk.stkLo = __KernelGetCurThreadStackStart(); g_lk.stkHi = __KernelGetCurThreadStack();
+		g_lk.in.clear();
+		g_tracing = true;
+		g_reading = !g_recDir.empty();
+		return false;
+	}
+	u32 op = Peek32(pc);
+	bool sys = (op & 0xFC00003F) == 0x0000000C;
+	bool back = pc == g_lk.ra && m->r[MIPS_REG_SP] == g_lk.sp && __KernelGetCurThread() == g_lk.thread;
+	if (g_lk.phase == 1) {
+		const char *why = nullptr;
+		if (__KernelGetCurThread() != g_lk.thread) why = "thread switch inside the call";
+		else if (__IsInInterrupt()) why = "interrupt inside the call";
+		else if (sys && !back) why = "system call inside the call";
+		if (why) {
+			// untestable here: the original simply carries on
+			LockLog("SKIP", why);
+			g_lk.phase = 0; g_lk.old1.clear(); g_lk.in.clear();
+			g_tracing = !g_frames.empty();
+			g_reading = false;
+			return false;
+		}
+		if (!back) { g_lk.n1++; return false; }
+		if (!g_recDir.empty()) { RecordCase(m); return false; }
+		// the original returned: keep its outputs, roll back, run the candidate from the entry
+		g_lk.after.Save(m);
+		for (auto &o : g_lk.old1) g_lk.fin1[o.first] = Peek(o.first);
+		for (auto &o : g_lk.old1) *Memory::GetPointerWriteUnchecked(o.first) = o.second;
+		LockFn &fn = g_lockFns[g_lk.func];
+		PutBytes(g_lk.func, fn.cand);
+		g_lk.entry.Load(m);
+		g_lk.downcount = m->downcount;
+		m->downcount = 0x3FFFFFFF;  // no slice end, so no interrupt or event, while the candidate runs
+		g_lk.phase = 2;
+		fn.tested++;
+		fn.exec[0] = 1;  // the entry instruction runs without a hook call (pc was set here)
+		return true;
+	}
+	// phase 2: the candidate
+	LockFn &fn = g_lockFns[g_lk.func];
+	if (pc >= g_lk.func && pc < g_lk.func + fn.size) fn.exec[(pc - g_lk.func) / 4] = 1;
+	if (sys && !back) { LockFinish("DIFF", "makes a system call"); return true; }
+	// a register jump to a non-code address would raise PPSSPP's exec exception and stop the core:
+	// stop the candidate before it executes instead (jr / jalr: SPECIAL, funct 8 / 9)
+	if ((op & 0xFC00003E) == 0x00000008) {
+		u32 t = m->r[(op >> 21) & 31];
+		if ((t & 3) || !Memory::IsValidAddress(t)) {
+			char why[96];
+			snprintf(why, sizeof(why), "jumps to an invalid address %08x at +%x", t, pc - g_lk.func);
+			LockFinish("DIFF", why);
+			return true;
+		}
+	}
+	if (++g_lk.n2 > 20 * g_lk.n1 + 100000) { LockFinish("DIFF", "does not return (instruction budget)"); return true; }
+	if (!back) return false;
+	char why[400] = "";
+	const Regs &a = g_lk.after;
+	if (m->r[MIPS_REG_SP] != a.r[MIPS_REG_SP]) snprintf(why, sizeof(why), "sp");
+	for (int i = 16; i <= 23 && !why[0]; i++)
+		if (m->r[i] != a.r[i]) snprintf(why, sizeof(why), "callee-saved $s%d %08x vs %08x", i - 16, m->r[i], a.r[i]);
+	if (!why[0] && m->r[30] != a.r[30]) snprintf(why, sizeof(why), "callee-saved $s8 %08x vs %08x", m->r[30], a.r[30]);
+	for (int i = 20; i <= 31 && !why[0]; i++)
+		if (m->fi[i] != a.fi[i]) snprintf(why, sizeof(why), "callee-saved $f%d %08x vs %08x", i, m->fi[i], a.fi[i]);
+	if (!why[0] && fn.rk >= 1 && fn.rk <= 2 && m->r[MIPS_REG_V0] != a.r[MIPS_REG_V0])
+		snprintf(why, sizeof(why), "v0 %08x vs %08x", m->r[MIPS_REG_V0], a.r[MIPS_REG_V0]);
+	if (!why[0] && fn.rk == 2 && m->r[MIPS_REG_V1] != a.r[MIPS_REG_V1])
+		snprintf(why, sizeof(why), "v1 %08x vs %08x", m->r[MIPS_REG_V1], a.r[MIPS_REG_V1]);
+	if (!why[0] && fn.rk == 3 && m->fi[0] != a.fi[0])
+		snprintf(why, sizeof(why), "f0 %08x vs %08x", m->fi[0], a.fi[0]);
+	if (!why[0]) {
+		// memory: every byte either run changed, outside its own frame, must end the same. The
+		// candidate started from the rolled-back entry state, so RAM now holds its final bytes; the
+		// original's are fin1, or the entry value where only the candidate wrote.
+		std::map<u32, u8> entry = g_lk.old2;
+		for (auto &o : g_lk.old1) entry.emplace(o.first, o.second);
+		int n = 0; u32 first = 0; u8 fo = 0, fc = 0;
+		for (auto &o : entry) {
+			u32 b = o.first;
+			if (!Outside(b)) continue;
+			auto f = g_lk.fin1.find(b);
+			u8 vo = f != g_lk.fin1.end() ? f->second : o.second;
+			u8 vc = Peek(b);
+			if (vo != vc && !n++) { first = b; fo = vo; fc = vc; }
+		}
+		if (n) snprintf(why, sizeof(why), "memory: %d bytes differ, first %08x (candidate %02x, original %02x)", n, first, fc, fo);
+	}
+	LockFinish(why[0] ? "DIFF" : "PASS", why[0] ? why : "-");
+	return true;
+}
+
+void OnRead(u32 addr, int size) {
+	u32 pc = currentMIPS->pc;
+	if (addr >= pc && addr < pc + 8) return;  // instruction fetch and delay-slot lookups, not data
+	if (!g_recs.empty()) {
+		for (auto &r : g_recs)
+			for (int i = 0; i < size; i++) {
+				u32 b = addr + i;
+				if (Memory::IsValidAddress(b) && !r.old1.count(b)) r.in.emplace(b, Peek(b));
+			}
+		return;
+	}
+	if (!g_lk.phase) return;
+	for (int i = 0; i < size; i++) {
+		u32 b = addr + i;
+		if (!Memory::IsValidAddress(b)) continue;
+		if (!g_lk.replay) {
+			// an input: read before this call wrote it
+			if (!g_lk.old1.count(b)) g_lk.in.emplace(b, Peek(b));
+		} else if (!g_inset->has(b) && !g_w2->has(b) && !(b >= g_lk.stkLo && b < g_lk.sp)) {
+			if (!g_lk.unrec++) g_lk.unrecFirst = b;  // the original never read it: not a recorded input
+		}
+	}
+}
+
+void LoadRecord(const char *spec, const char *dir, long long perFn, u32 moduleBase) {
+	ParseSpec(spec, moduleBase);
+	g_recDir = dir;
+	if (perFn > 0) g_recPerFn = (u64)perFn;
+	g_lockLog = fopen((std::string(dir) + "/record.log").c_str(), "w");
+}
+
+// Replay one function's cases with its candidate in the slot. The machine is the booted game
+// (retail code everywhere else, for the callees); each case's inputs are written in, its entry
+// registers set, the candidate run to its return and compared with the case's outputs, and
+// everything put back.
+void Replay(const char *spec, const char *dir, const char *log, u32 moduleBase) {
+	ParseSpec(spec, moduleBase);
+	FILE *L = fopen(log, "w");
+	MIPSState *m = currentMIPS;
+	Regs saved; saved.Save(m);
+	int savedDown = m->downcount;
+	g_w2 = new ByteSet(); g_inset = new ByteSet();
+	u32 annexLo = ~0u, annexHi = 0;  // nothing a case reads or writes may be in it
+	for (auto &d : g_specData) {
+		PutBytes(d.first, d.second);
+		annexLo = std::min(annexLo, d.first); annexHi = std::max(annexHi, d.first + (u32)d.second.size());
+	}
+	for (auto &e : g_lockFns)
+		if (e.second.load != e.first) {
+			annexLo = std::min(annexLo, e.second.load);
+			annexHi = std::max(annexHi, e.second.load + (u32)e.second.cand.size());
+		}
+	for (auto &e : g_lockFns) {
+		LockFn &fn = e.second;
+		u32 off = e.first - moduleBase;
+		char path[600];
+		snprintf(path, sizeof(path), "%s/%06x.cases", dir, off);
+		FILE *f = fopen(path, "rb");
+		if (!f) { fprintf(L, "NOCASES %06x\n", off); continue; }
+		fn.orig.resize(fn.size);
+		memcpy(fn.orig.data(), Memory::GetPointerUnchecked(e.first), fn.size);
+		if (fn.cand.empty()) fn.cand = fn.orig;  // identity: the slot's own bytes
+		PutBytes(fn.load, fn.cand);
+		if (fn.load != e.first) {
+			// the slot jumps to the annexed body, so callers and recursion reach it
+			std::vector<u8> thunk(8, 0);
+			u32 j = 0x08000000 | ((fn.load >> 2) & 0x03FFFFFF);
+			memcpy(thunk.data(), &j, 4);
+			PutBytes(e.first, thunk);
+		}
+		char magic[4];
+		while (fread(magic, 1, 4, f) == 4 && !memcmp(magic, "RRC", 3) && magic[3] >= '1' && magic[3] <= '3') {
+			u32 o, n; u64 call;
+			fread(&o, 4, 1, f); fread(&call, 8, 1, f);
+			fread(&g_lk.sp, 4, 1, f); fread(&g_lk.stkLo, 4, 1, f); fread(&g_lk.stkHi, 4, 1, f);
+			fread(&g_lk.entry, sizeof(Regs), 1, f); fread(&g_lk.after, sizeof(Regs), 1, f);
+			std::map<u32, u8> in, out;
+			for (auto *v : {&in, &out}) {
+				fread(&n, 4, 1, f);
+				for (u32 k = 0; k < n; k++) { u32 a; u8 b; fread(&a, 4, 1, f); fread(&b, 1, 1, f); (*v)[a] = b; }
+			}
+			std::vector<Sys> sys;
+			u64 origSteps = 200000;  // older cases did not record it
+			if (magic[3] >= '2') {
+				fread(&n, 4, 1, f);
+				sys.resize(n);
+				if (n) fread(sys.data(), sizeof(Sys), n, f);
+			}
+			if (magic[3] >= '3') fread(&origSteps, 8, 1, f);
+			u64 budget = 10 * origSteps + 10000;
+			size_t si = 0;
+			bool clash = false;
+			for (auto *v : {&in, &out})
+				for (auto &x : *v)
+					if (x.first >= annexLo && x.first < annexHi) clash = true;
+			if (clash) { fprintf(L, "SKIP %06x %llu case touches the annex\n", off, (unsigned long long)call); continue; }
+			// the inputs
+			std::map<u32, u8> before;
+			for (auto &x : in) { before.emplace(x.first, Peek(x.first)); Poke(x.first, x.second); g_inset->set(x.first); }
+			g_lk.func = e.first; g_lk.call = call;
+			g_old2v.clear(); g_lk.unrec = 0; g_lk.replay = true; g_lk.phase = 2;
+			g_tracing = true; g_reading = true;
+			g_lk.entry.Load(m);
+			m->pc = fn.load;
+			u32 ra = g_lk.entry.r[MIPS_REG_RA];
+			fn.exec[0] = 1;
+			const char *verdict = nullptr; char why[400] = "";
+			u64 steps = 0;
+			for (;;) {
+				u32 pc = m->pc;
+				if (pc == ra && m->r[MIPS_REG_SP] == g_lk.sp && !m->inDelaySlot) break;
+				if (pc >= fn.load && pc < fn.load + 4 * fn.exec.size()) fn.exec[(pc - fn.load) / 4] = 1;
+				if ((pc & 3) || !Memory::IsValidRange(pc, 4)) { verdict = "DIFF"; snprintf(why, sizeof(why), "runs at an invalid address %08x", pc); break; }
+				u32 op = Peek32(pc);
+				if ((op & 0xFC00003F) == 0x0000000C) {
+					// only the original's own allowed system calls, in its order, with its arguments
+					const HLEFunction *info = GetSyscallFuncPointer(MIPSOpcode(op));
+					const char *nm = info && info->name ? info->name : "?";
+					int na = PureSys(nm);
+					bool ok = na >= 0 && si < sys.size() && !strcmp(sys[si].name, nm);
+					for (int k = 0; ok && k < na; k++) ok = sys[si].a[k] == m->r[4 + k];
+					if (!ok) { verdict = "DIFF"; snprintf(why, sizeof(why), "system call %s where the original made %s", nm, si < sys.size() ? sys[si].name : "none"); break; }
+					m->r[MIPS_REG_V0] = sys[si].v0; m->r[MIPS_REG_V1] = sys[si].v1;
+					si++;
+					if (m->inDelaySlot) { m->pc = m->nextPC; m->inDelaySlot = false; } else m->pc += 4;
+					continue;
+				}
+				if ((op & 0xFC00003E) == 0x00000008) {
+					u32 t = m->r[(op >> 21) & 31];
+					if ((t & 3) || !Memory::IsValidAddress(t)) { verdict = "DIFF"; snprintf(why, sizeof(why), "jumps to an invalid address %08x at +%x", t, pc - e.first); break; }
+				}
+				if (++steps > budget) { verdict = "DIFF"; snprintf(why, sizeof(why), "does not return within %llu instructions (original: %llu)", (unsigned long long)budget, (unsigned long long)origSteps); break; }
+				bool was = m->inDelaySlot;
+				MIPSInterpret(MIPSOpcode(op));
+				if (m->inDelaySlot && was) { m->pc = m->nextPC; m->inDelaySlot = false; }
+			}
+			g_reading = false;
+			if (!verdict && si != sys.size()) { verdict = "DIFF"; snprintf(why, sizeof(why), "makes %zu of the original's %zu system calls", si, sys.size()); }
+			if (!verdict) {
+				const Regs &a = g_lk.after;
+				if (m->r[MIPS_REG_SP] != a.r[MIPS_REG_SP]) snprintf(why, sizeof(why), "sp");
+				for (int i = 16; i <= 23 && !why[0]; i++)
+					if (m->r[i] != a.r[i]) snprintf(why, sizeof(why), "callee-saved $s%d %08x vs %08x", i - 16, m->r[i], a.r[i]);
+				if (!why[0] && m->r[30] != a.r[30]) snprintf(why, sizeof(why), "callee-saved $s8 %08x vs %08x", m->r[30], a.r[30]);
+				for (int i = 20; i <= 31 && !why[0]; i++)
+					if (m->fi[i] != a.fi[i]) snprintf(why, sizeof(why), "callee-saved $f%d %08x vs %08x", i, m->fi[i], a.fi[i]);
+				if (!why[0] && fn.rk >= 1 && fn.rk <= 2 && m->r[MIPS_REG_V0] != a.r[MIPS_REG_V0])
+					snprintf(why, sizeof(why), "v0 %08x vs %08x", m->r[MIPS_REG_V0], a.r[MIPS_REG_V0]);
+				if (!why[0] && fn.rk == 2 && m->r[MIPS_REG_V1] != a.r[MIPS_REG_V1])
+					snprintf(why, sizeof(why), "v1 %08x vs %08x", m->r[MIPS_REG_V1], a.r[MIPS_REG_V1]);
+				if (!why[0] && fn.rk == 3 && m->fi[0] != a.fi[0])
+					snprintf(why, sizeof(why), "f0 %08x vs %08x", m->fi[0], a.fi[0]);
+				if (!why[0]) {
+					// memory: the original's outputs must be there, and nothing else outside the
+					// candidate's own frame may have changed
+					int nd = 0; u32 first = 0; u8 fc = 0, fo = 0;
+					for (auto &x : out)
+						if (Peek(x.first) != x.second && !nd++) { first = x.first; fc = Peek(x.first); fo = x.second; }
+					for (auto &x : g_old2v) {
+						if (!Outside(x.first) || out.count(x.first)) continue;
+						auto i = in.find(x.first);
+						u8 entryv = i != in.end() ? i->second : x.second;
+						if (Peek(x.first) != entryv && !nd++) { first = x.first; fc = Peek(x.first); fo = entryv; }
+					}
+					if (nd) snprintf(why, sizeof(why), "memory: %d bytes differ, first %08x (candidate %02x, original %02x)", nd, first, fc, fo);
+				}
+				verdict = why[0] ? "DIFF" : "PASS";
+			}
+			fprintf(L, "%s %06x %llu %s", verdict, off, (unsigned long long)call, why[0] ? why : "-");
+			if (g_lk.unrec) fprintf(L, " | reads %llu bytes the original did not, first %08x", (unsigned long long)g_lk.unrec, g_lk.unrecFirst);
+			fprintf(L, "\n");
+			// put everything back
+			for (auto it = g_old2v.rbegin(); it != g_old2v.rend(); ++it) { Poke(it->first, it->second); g_w2->reset(it->first); }
+			for (auto &x : before) Poke(x.first, x.second);
+			for (auto &x : in) g_inset->reset(x.first);
+			g_old2v.clear(); g_lk.phase = 0; g_lk.replay = false;
+			g_tracing = false;
+		}
+		fclose(f);
+		PutBytes(e.first, fn.orig);
+		g_lk.replay = false;
+		u32 nx = 0;
+		std::string missed;
+		for (size_t k = 0; k < fn.exec.size(); k++) {
+			if (fn.exec[k]) nx++;
+			else { char b[16]; snprintf(b, sizeof(b), " %x", (u32)(off + 4 * k)); missed += b; }
+		}
+		fprintf(L, "COV %06x %zu %u%s\n", off, fn.exec.size(), nx, missed.c_str());
+	}
+	fclose(L);
+	saved.Load(m);
+	m->downcount = savedDown;
+}
+
+void LockstepFinish() {
+	if (g_lockCov.empty()) return;
+	FILE *f = fopen(g_lockCov.c_str(), "w");
+	if (!f) return;
+	for (auto &e : g_lockFns) {
+		u32 n = 0; std::string missed;
+		for (size_t k = 0; k < e.second.exec.size(); k++) {
+			if (e.second.exec[k]) n++;
+			else { char b[16]; snprintf(b, sizeof(b), " %x", (u32)(e.first + 4 * k - g_base)); missed += b; }
+		}
+		fprintf(f, "%06x %zu %u %llu %llu%s\n", e.first - g_base, e.second.exec.size(), n,
+			(unsigned long long)e.second.calls, (unsigned long long)e.second.tested, missed.c_str());
+	}
+	fclose(f);
+	if (g_lockLog) fclose(g_lockLog);
+}
+
+static inline u64 Byte(u32 addr, u8 v) { return Mix(Mix(0x51ED270B27D2A3C1ULL, addr), v); }
+// A value pointing into the running thread's stack is logged as "stk": where a local sits depends on
+// its function's frame layout, which a draft is free to differ in, so only that it is a stack
+// address is behaviour.
+static const char *Val(char *buf, u32 v) {
+	if (v >= __KernelGetCurThreadStackStart() && v < __KernelGetCurThreadStack())
+		return "stk";
+	snprintf(buf, 9, "%08x", v);
+	return buf;
+}
+
+void Load(const char *watchFile, const char *logFile, u32 moduleBase) {
+	g_base = moduleBase;
+	FILE *f = fopen(watchFile, "r");
+	if (!f) { fprintf(stderr, "rrbox: cannot read %s\n", watchFile); return; }
+	std::vector<u32> addrs;
+	char line[128];
+	while (fgets(line, sizeof(line), f)) {
+		unsigned a, size = 0;
+		int n = line[0] != '#' ? sscanf(line, "%x %u", &a, &size) : 0;
+		if (n >= 1) addrs.push_back(moduleBase + a);
+		if (n == 2) g_ranges.push_back({moduleBase + a, size});
+	}
+	fclose(f);
+	if (!g_ranges.empty()) {
+		g_clo = 0xFFFFFFFF; g_chi = 0;
+		for (auto &r : g_ranges) { if (r.first < g_clo) g_clo = r.first; if (r.first + r.second > g_chi) g_chi = r.first + r.second; }
+		g_exec.assign((g_chi - g_clo) / 4, 0);
+		g_covPath = std::string(logFile) + ".cov";
+	}
+	if (addrs.empty()) return;
+	g_lo = 0xFFFFFFFF; g_hi = 0;
+	for (u32 a : addrs) { if (a < g_lo) g_lo = a; if (a > g_hi) g_hi = a; }
+	g_watch.assign((g_hi - g_lo) / 4 + 1, 0);
+	for (u32 a : addrs) g_watch[(a - g_lo) / 4] = 1;
+	g_log = fopen(logFile, "w");
+	g_logPath = logFile;
+}
+
+void Reset() {
+	g_frames.clear();
+	g_calls.clear();
+	g_forceSeen.clear();
+	std::fill(g_exec.begin(), g_exec.end(), 0);
+	if (g_log) {
+		fclose(g_log);
+		g_log = fopen(g_logPath.c_str(), "w");
+	}
+	g_tracing = false;
+}
+
+void LoadCycleRef(const char *path) {
+	FILE *f = fopen(path, "r");
+	char line[512];
+	while (f && fgets(line, sizeof(line), f)) {
+		unsigned func; unsigned long long call; long long cyc;
+		const char *c = strstr(line, " cyc=");
+		if (line[0] == 'R' && c && sscanf(line + 2, "%x %llu", &func, &call) == 2 && sscanf(c + 5, "%lld", &cyc) == 1)
+			g_refCycles[{func, call}] = cyc;
+		const char *k = strstr(line, " tk=");
+		if (line[0] == 'E' && k && sscanf(line + 2, "%x %llu", &func, &call) == 2 && sscanf(k + 4, "%lld", &cyc) == 1)
+			g_refEntry[{func, call}] = cyc;
+	}
+	if (f) fclose(f);
+}
+
+void AddForce(const char *name, int n, u32 value) { g_force[name][n] = value; }
+
+void OnSyscallReturn(const char *name) {
+	if (g_pending && name && !strcmp(name, g_pendingSys.name)) {
+		g_pending = false;
+		g_pendingSys.v0 = currentMIPS->r[MIPS_REG_V0]; g_pendingSys.v1 = currentMIPS->r[MIPS_REG_V1];
+		for (auto &r : g_recs) r.sys.push_back(g_pendingSys);
+	}
+	if (g_force.empty() || !name) return;
+	auto f = g_force.find(name);
+	if (f == g_force.end()) return;
+	int n = g_forceSeen[name]++;
+	auto v = f->second.find(n);
+	if (v != f->second.end()) currentMIPS->r[MIPS_REG_V0] = v->second;
+}
+
+void Finish() {
+	if (g_covPath.empty()) return;
+	FILE *f = fopen(g_covPath.c_str(), "w");
+	if (!f) return;
+	for (auto &r : g_ranges) {
+		u32 n = 0;
+		std::string missed;
+		for (u32 a = r.first; a < r.first + r.second; a += 4) {
+			if (g_exec[(a - g_clo) / 4]) n++;
+			else { char b[16]; snprintf(b, sizeof(b), " %x", a - g_base); missed += b; }
+		}
+		fprintf(f, "%06x %u %u%s\n", r.first - g_base, r.second / 4, n, missed.c_str());
+	}
+	fclose(f);
+}
+
+void OnPC(u32 pc) {
+	if (!g_recDir.empty()) { RecPC(pc); return; }
+	if (!g_lockFns.empty()) { LockPC(pc); return; }
+	if (!g_log) return;
+	if (pc >= g_clo && pc < g_chi) g_exec[(pc - g_clo) / 4] = 1;
+	int thread = __KernelGetCurThread();
+	// returns: the innermost frame of this thread whose return address and stack are back
+	for (int k = (int)g_frames.size() - 1; k >= 0; k--) {
+		Frame &fr = g_frames[k];
+		if (fr.thread != thread) continue;
+		if (pc == fr.ra && currentMIPS->r[MIPS_REG_SP] == fr.sp) {
+			// callee-saved registers s0..s7 and s8/fp must come back unchanged
+			int clobbered = 0;
+			for (int i = 0; i < 9; i++)
+				if (currentMIPS->r[i < 8 ? 16 + i : 30] != fr.saved[i]) clobbered |= 1 << i;
+			s64 cyc = (s64)CoreTiming::GetTicks() - fr.t0;
+			auto ref = g_refCycles.find({fr.func - g_base, fr.call});
+			if (ref != g_refCycles.end() && ref->second != cyc) {
+				// time-equalised lockstep: from here on the candidate is exactly as far along as retail
+				currentMIPS->downcount += (int)(cyc - ref->second);
+				cyc = ref->second;
+			}
+			char b0[9], b1[9];
+			fprintf(g_log, "R %06x %llu v0=%s v1=%s f0=%08x writes=%llu hash=%016llx clobbered=%03x cyc=%lld\n",
+				fr.func - g_base, (unsigned long long)fr.call, Val(b0, currentMIPS->r[MIPS_REG_V0]), Val(b1, currentMIPS->r[MIPS_REG_V1]),
+				currentMIPS->fi[0], (unsigned long long)fr.writes, (unsigned long long)fr.hash, clobbered, (long long)cyc);
+			g_frames.erase(g_frames.begin() + k);
+		}
+		break;
+	}
+	if (pc >= g_lo && pc <= g_hi && g_watch[(pc - g_lo) / 4] && !currentMIPS->inDelaySlot) {
+		u64 call = g_calls[pc]++;
+		// time-equalised lockstep at entry too: code that ran since the last watched boundary (a
+		// draft caller's own instructions) may have taken a different number of cycles, and the
+		// call would then read a different clock
+		auto ref = g_refEntry.find({pc - g_base, call});
+		if (ref != g_refEntry.end()) {
+			s64 now = (s64)CoreTiming::GetTicks();
+			if (now != ref->second)
+				currentMIPS->downcount += (int)(now - ref->second);
+		}
+		// RRBOX_DUMPAT=FUNC:CALL:FILE writes all of user RAM at that call's entry, to diff two runs
+		// and find the memory a byte-exact function read differently
+		static int dumpAt = -1;
+		static u32 dFunc = 0;
+		static unsigned long long dCall = 0;
+		static char dPath[400];
+		if (dumpAt < 0) {
+			const char *e = getenv("RRBOX_DUMPAT");
+			dumpAt = e && sscanf(e, "%x:%llu:%399s", &dFunc, &dCall, dPath) == 3;
+		}
+		if (dumpAt && pc - g_base == dFunc && call == dCall) {
+			if (FILE *d = fopen(dPath, "wb")) {
+				fwrite(Memory::GetPointerUnchecked(PSP_GetUserMemoryBase()), 1, PSP_GetUserMemoryEnd() - PSP_GetUserMemoryBase(), d);
+				fclose(d);
+			}
+			// beside it, every thread's stack (start size): dead stack contents are not state
+			if (FILE *d = fopen((std::string(dPath) + ".stacks").c_str(), "w")) {
+				for (const DebugThreadInfo &t : GetThreadsInfo())
+					fprintf(d, "%08x %x\n", t.initialStack, t.stackSize);
+				fclose(d);
+			}
+		}
+		const u32 *r = currentMIPS->r;
+		const u32 *fi = currentMIPS->fi;
+		char b[6][9];
+		fprintf(g_log, "E %06x %llu t=%d a0=%s a1=%s a2=%s a3=%s t0=%s t1=%s f12=%08x f13=%08x f14=%08x f15=%08x tk=%lld\n",
+			pc - g_base, (unsigned long long)call, thread, Val(b[0], r[4]), Val(b[1], r[5]), Val(b[2], r[6]), Val(b[3], r[7]),
+			Val(b[4], r[8]), Val(b[5], r[9]), fi[12], fi[13], fi[14], fi[15], (long long)CoreTiming::GetTicks());
+		Frame fr{pc, r[MIPS_REG_RA], r[MIPS_REG_SP], thread, call, 0, 0, {}, (s64)CoreTiming::GetTicks()};
+		for (int i = 0; i < 9; i++) fr.saved[i] = r[i < 8 ? 16 + i : 30];
+		g_frames.push_back(fr);
+	}
+	g_tracing = !g_frames.empty();
+}
+
+void OnWrite(u32 addr, u64 value, int size) {
+	if (!g_recs.empty()) {
+		for (auto &r : g_recs)
+			for (int i = 0; i < size; i++)
+				if (Memory::IsValidAddress(addr + i)) r.old1.emplace(addr + i, Peek(addr + i));
+		return;
+	}
+	if (g_lk.replay) {
+		for (int i = 0; i < size; i++) {
+			u32 b = addr + i;
+			if (!g_w2->has(b) && Memory::IsValidAddress(b)) { g_w2->set(b); g_old2v.push_back({b, Peek(b)}); }
+		}
+		return;
+	}
+	if (g_lk.phase) {
+		// the lockstep journal: each byte's value before the running side first wrote it
+		std::map<u32, u8> &j = g_lk.phase == 1 ? g_lk.old1 : g_lk.old2;
+		for (int i = 0; i < size; i++)
+			if (Memory::IsValidAddress(addr + i))
+				j.emplace(addr + i, Peek(addr + i));
+		return;
+	}
+	// RRBOX_WADDR=ADDR (hex, absolute) logs every write that touches that byte as
+	// "A addr value size pc thread innermost-watched-func call", to find who changed it
+	static int waddr = -1;
+	static u32 wa = 0;
+	if (waddr < 0) {
+		const char *e = getenv("RRBOX_WADDR");
+		waddr = e && sscanf(e, "%x", &wa) == 1;
+	}
+	if (waddr && g_log && wa >= addr && wa < addr + (u32)size) {
+		int t = __KernelGetCurThread();
+		const Frame *in = nullptr;
+		for (const Frame &fr : g_frames)
+			if (fr.thread == t) in = &fr;
+		fprintf(g_log, "A %08x %08llx %d pc=%06x t=%d in=%06x %llu\n", addr, (unsigned long long)value, size,
+			currentMIPS->pc - g_base, t, in ? in->func - g_base : 0, in ? (unsigned long long)in->call : 0ULL);
+	}
+	// RRBOX_WDETAIL=FUNC:CALL (hex offset, decimal call number) logs each hashed write of that one
+	// call as "W addr value size pc", to find which write makes a call's hash differ
+	static int detail = -1;
+	static u32 dFunc = 0;
+	static u64 dCall = 0;
+	if (detail < 0) {
+		const char *e = getenv("RRBOX_WDETAIL");
+		unsigned long long c = 0;
+		detail = e && sscanf(e, "%x:%llu", &dFunc, &c) == 2;
+		dCall = c;
+	}
+	// The hash is of the call's net effect on memory, not of its write sequence: each byte written
+	// adds H(addr, new) - H(addr, old), which telescopes to the sum over the bytes the call changed
+	// of H(addr, final) - H(addr, before the call). Two calls that leave memory the same agree
+	// whatever order they stored in (independent stores scheduled differently, a field written
+	// twice), and a byte stored and then restored counts for nothing.
+	//
+	// A write into the running thread's own stack is a local of some frame on it. Below a call's
+	// entry sp it is the call's own frame or a callee's, whose layout is the compiler's business: not
+	// counted. At or above it, it is a caller's local reached through a pointer, an output parameter:
+	// counted, but by value and position within the word only, since where the caller keeps it
+	// depends on the caller's frame layout, which a draft is free to differ in; and by the value
+	// written alone, since what the slot held before is usually an uninitialised local.
+	bool stack = addr >= __KernelGetCurThreadStackStart() && addr < __KernelGetCurThreadStack();
+	u64 delta = 0;
+	for (int i = 0; i < size; i++) {
+		u32 b = addr + i;
+		u8 nv = (u8)(value >> (8 * i));
+		u8 ov = Memory::IsValidAddress(b) ? Memory::Read_U8(b) : 0;
+		if (stack)
+			delta += Byte(0x5A000000 | (b & 3), nv);
+		else if (nv != ov)
+			delta += Byte(b, nv) - Byte(b, ov);
+	}
+	int thread = __KernelGetCurThread();
+	for (Frame &fr : g_frames) {
+		if (fr.thread == thread && !(stack && addr < fr.sp)) {
+			fr.hash += delta;
+			fr.writes++;
+			if (detail && g_log && fr.func - g_base == dFunc && fr.call == dCall)
+				fprintf(g_log, "W %08x %08llx %d pc=%06x\n", addr, (unsigned long long)value, size, currentMIPS->pc - g_base);
+		}
+	}
+}
+}
diff --git a/Core/RRBox.h b/Core/RRBox.h
new file mode 100644
index 0000000..61b998a
--- /dev/null
+++ b/Core/RRBox.h
@@ -0,0 +1,39 @@
+// rrbox: per-function call tracing for the Ridge Racer decomp's A5 oracle.
+// Watched functions log their arguments at entry and, at return, their return registers plus a
+// hash of the call's net effect on memory (callees included, calling thread only, own stack frames
+// excluded): what each written byte ends as, whatever order it was stored in.
+#pragma once
+#include <cstdio>
+#include <vector>
+#include "Common/CommonTypes.h"
+
+namespace RRBox {
+extern bool g_tracing;                  // any watched call active: memory writes are hashed
+extern bool g_reading;                  // a call is being recorded: memory reads are its inputs
+void Load(const char *watchFile, const char *logFile, u32 moduleBase);
+// Candidate runs: give each watched call exactly the emulated time it took in retail.
+void LoadCycleRef(const char *retailCallLog);
+// Write instruction coverage of the watched functions (lines: offset size executed-words).
+void Finish();
+// Fault injection: the Nth call (0-based) of system function NAME returns VALUE instead.
+void AddForce(const char *name, int n, u32 value);
+void OnSyscallReturn(const char *name);   // after the HLE function ran, before any thread switch
+// After a snapshot is loaded (--rr-start): forget the boot's open calls, call counts, coverage and
+// forced-call counts, and start the call log afresh, so both runs count from the snapshot.
+void Reset();
+// Per-call lockstep: SPEC lines "OFFSET SIZE RETKIND HEXBYTES" (the candidate's body for the
+// retail slot); LOG gets one line per tested call (PASS / DIFF what / SKIP why), COV the
+// candidate bodies' instruction coverage. At most PERFN calls of each function are tested.
+void LoadLockstep(const char *spec, const char *log, const char *cov, long long perFn, u32 moduleBase);
+void LockstepFinish();
+void OnPC(u32 pc);                      // before each interpreted instruction
+void OnWrite(u32 addr, u64 value, int size);
+void OnRead(u32 addr, int size);
+// Case recording (--rr-record=SPEC:DIR[:PERFN]): at calls of the SPEC functions, write one case per
+// call to DIR/OFFSET.cases: entry registers, every byte the call read before writing it (its
+// inputs), every byte it changed outside its own frame and its registers at the return (outputs).
+void LoadRecord(const char *spec, const char *dir, long long perFn, u32 moduleBase);
+// Case replay (--rr-replay=SPEC:DIR:LOG): run each SPEC candidate on every recorded case of its
+// function, from the case's inputs, and compare with the case's outputs. Returns when done.
+void Replay(const char *spec, const char *dir, const char *log, u32 moduleBase);
+}
