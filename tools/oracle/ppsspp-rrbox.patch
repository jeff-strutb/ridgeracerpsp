+// rrbox: the Ridge Racer decomp's behaviour oracle. A frame-indexed input script drives the
+// game; every frame logs the emulated cycle count and a hash of user RAM so two runs (original vs candidate image) can be
+// compared frame for frame. See tools/oracle/README.md in the decomp repository.
+struct RRBoxOptions {
+	int frames = 0;              // stop after this many frames (0 = until timeout)
+	std::string script;          // lines: FRAME BUTTONS  (BUTTONS = 0xMASK or NAME+NAME, or NONE)
+	std::string trace;           // output: one line per frame: frame cycles ramhash
+	int shotEvery = 0;           // save the displayed frame as PNG every N frames ...
+	std::string shotDir;         // ... into this directory (frame_NNNNN.png)
+	u32 skipStart = 0, skipEnd = 0; // address range left out of the RAM hash (the game's code, for M1 images)
+	std::vector<u32> peek;       // addresses whose words are appended to every trace line
+	std::string ref;             // reference trace: at the first frame whose hash differs, dump RAM and stop
+	int dumpFrame = -1;          // write user RAM at the end of this frame to dumpFile
+	std::string dumpFile;
+};
+static RRBoxOptions g_rr;
+
+// rrbox driver: from frame `start` on, the inputs are chosen by search instead of read from the
+// script. At every `step` frames the machine is snapshotted (savestate in memory); each option
+// (an input held for `step` frames, then a second input up to `horizon` frames) is played out
+// from the snapshot, and the one whose car ends furthest (straight line) from where it began
+// is kept: hitting a wall or spinning costs distance. Chosen inputs are written as script lines
+// (FRAME 0xMASK), so the drive can be replayed by any rrbox run without search.
+struct RRDrive {
+	int start = -1, step = 20, horizon = 80;
+	std::string out;
+	bool rolling = false;
+	int base = 0, next = 0, opt = 0;
+	u32 baseHeld = 0;
+	std::vector<u8> state;
+	float p0[3] = {};
+	std::vector<float> score;
+};
+static RRDrive g_drv;
+static const u32 RR_GAS = 0x4000, RR_L = 0x80, RR_R = 0x20;  // CROSS accelerates; d-pad steers
+static const u32 g_drvOpts[][2] = {
+	{RR_GAS, RR_GAS}, {RR_GAS | RR_L, RR_GAS}, {RR_GAS | RR_R, RR_GAS},
+	{RR_GAS | RR_L, RR_GAS | RR_L}, {RR_GAS | RR_R, RR_GAS | RR_R},
+};
+static const int g_drvN = sizeof(g_drvOpts) / sizeof(g_drvOpts[0]);
+// The player's car position (US, measured: the camera's position is this x1000 when driving
+// straight; the camera itself swings out on every turn, so it is no measure of progress).
+static void RRCar(float p[3]) {
+	for (int k = 0; k < 3; k++) {
+		u32 w = Memory::Read_U32(0x08a4d3b0 + 4 * k);
+		memcpy(&p[k], &w, 4);
+	}
+}
+static std::string g_rrWatch, g_rrCalls;  // A5: watched function list and the call log
+static std::string g_rrCyclesRef;         // A5 candidate runs: retail's call log, for time-equalised lockstep
+
+static u32 RRButtons(const std::string &tok) {
+	if (tok.rfind("0x", 0) == 0) return (u32)strtoul(tok.c_str(), nullptr, 16);
+	static const struct { const char *n; u32 v; } names[] = {
+		{"SELECT", 0x1}, {"START", 0x8}, {"UP", 0x10}, {"RIGHT", 0x20}, {"DOWN", 0x40}, {"LEFT", 0x80},
+		{"L", 0x100}, {"R", 0x200}, {"TRIANGLE", 0x1000}, {"CIRCLE", 0x2000}, {"CROSS", 0x4000},
+		{"SQUARE", 0x8000}, {"NONE", 0}};
+	u32 m = 0; size_t a = 0;
+	while (a <= tok.size()) {
+		size_t b = tok.find('+', a); if (b == std::string::npos) b = tok.size();
+		std::string n = tok.substr(a, b - a); bool ok = false;
+		for (auto &e : names) if (n == e.n) { m |= e.v; ok = true; }
+		if (!ok) { fprintf(stderr, "rrbox: unknown button '%s'\n", n.c_str()); exit(2); }
+		a = b + 1;
+	}
+	return m;
+}
+
