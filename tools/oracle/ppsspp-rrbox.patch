+// rrbox: the Ridge Racer decomp's behaviour oracle. A frame-indexed input script drives the
+// game; every frame logs the emulated cycle count and a hash of user RAM so two runs (original vs candidate image) can be
+// compared frame for frame. See tools/oracle/README.md in the decomp repository.
+struct RRBoxOptions {
+	int frames = 0;              // stop after this many frames (0 = until timeout)
+	std::string script;          // lines: FRAME BUTTONS  (BUTTONS = 0xMASK or NAME+NAME, or NONE)
+	std::string trace;           // output: one line per frame: frame cycles ramhash
+	int shotEvery = 0;           // save the displayed frame as PNG every N frames ...
+	std::string shotDir;         // ... into this directory (frame_NNNNN.png)
+	u32 skipStart = 0, skipEnd = 0; // address range left out of the RAM hash (the game's code, for M1 images)
+	std::vector<u32> peek;       // addresses whose words are appended to every trace line
+	std::string ref;             // reference trace: at the first frame whose hash differs, dump RAM and stop
+	int dumpFrame = -1;          // write user RAM at the end of this frame to dumpFile
+	std::string dumpFile;
+	// Snapshots (tools/oracle/snap.py). --rr-save-at=F1,F2,...:DIR writes, at the end of each
+	// listed frame, DIR/frame_F.state (the whole machine), DIR/frame_F.meta ("F held-buttons")
+	// and DIR/frame_F.memstick/ (the memory stick folder as it is then). --rr-start=DIR/frame_F
+	// loads that snapshot at the end of the first frame instead of playing up to it, and
+	// --rr-patch=FILE then writes the candidate's code into RAM (lines "ADDR HEXBYTES").
+	std::set<int> saveAt;
+	std::string saveDir;
+	std::string start;
+	std::string patch;
+	// Per-call lockstep (tools/oracle/lock.py): --rr-lockstep=SPEC:LOG:COV, --rr-lockstep-per-fn=N
+	std::string lockSpec, lockLog, lockCov;
+	long long lockPerFn = 0;
+	// Cases (tools/oracle/cases.py): --rr-record=SPEC:DIR[:PERFN], --rr-replay=SPEC:DIR:LOG
+	std::string recSpec, recDir, repSpec, repDir, repLog;
+	long long recPerFn = 0;
+};
+static RRBoxOptions g_rr;
+
+// rrbox driver: from frame `start` on, the inputs are chosen by search instead of read from the
+// script. At every `step` frames the machine is snapshotted (savestate in memory); each option
+// (an input held for `step` frames, then a second input up to `horizon` frames) is played out
+// from the snapshot, and the one whose car gets furthest along its recent direction of travel
+// (from where it was `back` decisions ago to where it is now) is kept: hitting a wall or
+// spinning costs distance, and turning round scores negative. Straight-line distance alone
+// let a spun car drive the course backwards. Chosen inputs are written as script lines
+// (FRAME 0xMASK), so the drive can be replayed by any rrbox run without search.
+struct RRDrive {
+	int start = -1, step = 20, horizon = 80;
+	std::string out;
+	bool rolling = false;
+	int base = 0, next = 0, opt = 0;
+	u32 baseHeld = 0;
+	std::vector<u8> state;
+	float p0[3] = {};
+	std::vector<float> score;
+	std::vector<std::array<float, 3>> hist;  // car position at each decision
+	int back = 6;
+	// With --rr-drive-path: progress is measured along a recorded lap instead (a closed loop of
+	// x z points), so a spin cannot turn "forward" round. The car's place on it is the nearest
+	// point of a segment within a window of the place found at the last decision.
+	std::vector<std::array<float, 2>> path;
+	std::vector<float> arc;  // arc length at each path point
