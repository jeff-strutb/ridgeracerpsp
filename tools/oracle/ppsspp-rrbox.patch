diff --git a/Core/RRBox.cpp b/Core/RRBox.cpp
new file mode 100644
index 0000000..7572634
--- /dev/null
+++ b/Core/RRBox.cpp
@@ -0,0 +1,144 @@
+#include "Core/RRBox.h"
+#include <map>
+#include <string>
+#include "Core/MIPS/MIPS.h"
+#include "Core/HLE/sceKernelThread.h"
+#include "Core/CoreTiming.h"
+
+namespace RRBox {
+bool g_tracing = false;
+
+struct Frame { u32 func; u32 ra; u32 sp; int thread; u64 call; u64 hash; u64 writes; u32 saved[9]; s64 t0; };
+static std::vector<u8> g_watch;         // one byte per word of the module's .text: watched entry
+static std::vector<std::pair<u32, u32>> g_ranges;   // watched functions: (absolute start, size)
+static std::vector<u8> g_exec;          // one byte per word over [g_clo, g_chi): executed
+static u32 g_clo = 0, g_chi = 0;
+static std::string g_covPath;
+static std::map<std::string, std::map<int, u32>> g_force;  // name -> call index -> forced v0
+static std::map<std::string, int> g_forceSeen;
+static u32 g_base = 0, g_lo = 0, g_hi = 0;
+static std::vector<Frame> g_frames;
+static std::map<u32, u64> g_calls;      // calls seen per function
+static FILE *g_log = nullptr;
+static std::map<std::pair<u32, u64>, s64> g_refCycles;  // (func offset, call) -> retail cycles
+
+static inline u64 Mix(u64 h, u64 v) { h ^= v + 0x9E3779B97F4A7C15ULL + (h << 6) + (h >> 2); return h * 0xFF51AFD7ED558CCDULL; }
+
+void Load(const char *watchFile, const char *logFile, u32 moduleBase) {
+	g_base = moduleBase;
+	FILE *f = fopen(watchFile, "r");
+	if (!f) { fprintf(stderr, "rrbox: cannot read %s\n", watchFile); return; }
+	std::vector<u32> addrs;
+	char line[128];
+	while (fgets(line, sizeof(line), f)) {
+		unsigned a, size = 0;
+		int n = line[0] != '#' ? sscanf(line, "%x %u", &a, &size) : 0;
+		if (n >= 1) addrs.push_back(moduleBase + a);
+		if (n == 2) g_ranges.push_back({moduleBase + a, size});
+	}
+	fclose(f);
+	if (!g_ranges.empty()) {
+		g_clo = 0xFFFFFFFF; g_chi = 0;
+		for (auto &r : g_ranges) { if (r.first < g_clo) g_clo = r.first; if (r.first + r.second > g_chi) g_chi = r.first + r.second; }
+		g_exec.assign((g_chi - g_clo) / 4, 0);
+		g_covPath = std::string(logFile) + ".cov";
+	}
+	if (addrs.empty()) return;
+	g_lo = 0xFFFFFFFF; g_hi = 0;
+	for (u32 a : addrs) { if (a < g_lo) g_lo = a; if (a > g_hi) g_hi = a; }
+	g_watch.assign((g_hi - g_lo) / 4 + 1, 0);
+	for (u32 a : addrs) g_watch[(a - g_lo) / 4] = 1;
+	g_log = fopen(logFile, "w");
+}
+
+void LoadCycleRef(const char *path) {
+	FILE *f = fopen(path, "r");
+	char line[512];
+	while (f && fgets(line, sizeof(line), f)) {
+		unsigned func; unsigned long long call; long long cyc;
+		const char *c = strstr(line, " cyc=");
+		if (line[0] == 'R' && c && sscanf(line + 2, "%x %llu", &func, &call) == 2 && sscanf(c + 5, "%lld", &cyc) == 1)
+			g_refCycles[{func, call}] = cyc;
+	}
+	if (f) fclose(f);
+}
+
+void AddForce(const char *name, int n, u32 value) { g_force[name][n] = value; }
+
+void OnSyscallReturn(const char *name) {
+	if (g_force.empty() || !name) return;
+	auto f = g_force.find(name);
+	if (f == g_force.end()) return;
+	int n = g_forceSeen[name]++;
+	auto v = f->second.find(n);
+	if (v != f->second.end()) currentMIPS->r[MIPS_REG_V0] = v->second;
+}
+
+void Finish() {
+	if (g_covPath.empty()) return;
+	FILE *f = fopen(g_covPath.c_str(), "w");
+	if (!f) return;
+	for (auto &r : g_ranges) {
+		u32 n = 0;
+		std::string missed;
+		for (u32 a = r.first; a < r.first + r.second; a += 4) {
+			if (g_exec[(a - g_clo) / 4]) n++;
+			else { char b[16]; snprintf(b, sizeof(b), " %x", a - g_base); missed += b; }
+		}
+		fprintf(f, "%06x %u %u%s\n", r.first - g_base, r.second / 4, n, missed.c_str());
+	}
+	fclose(f);
+}
+
+void OnPC(u32 pc) {
+	if (!g_log) return;
+	if (pc >= g_clo && pc < g_chi) g_exec[(pc - g_clo) / 4] = 1;
+	int thread = __KernelGetCurThread();
+	// returns: the innermost frame of this thread whose return address and stack are back
+	for (int k = (int)g_frames.size() - 1; k >= 0; k--) {
+		Frame &fr = g_frames[k];
+		if (fr.thread != thread) continue;
+		if (pc == fr.ra && currentMIPS->r[MIPS_REG_SP] == fr.sp) {
+			// callee-saved registers s0..s7 and s8/fp must come back unchanged
+			int clobbered = 0;
+			for (int i = 0; i < 9; i++)
+				if (currentMIPS->r[i < 8 ? 16 + i : 30] != fr.saved[i]) clobbered |= 1 << i;
+			s64 cyc = (s64)CoreTiming::GetTicks() - fr.t0;
+			auto ref = g_refCycles.find({fr.func - g_base, fr.call});
+			if (ref != g_refCycles.end() && ref->second != cyc) {
+				// time-equalised lockstep: from here on the candidate is exactly as far along as retail
+				currentMIPS->downcount += (int)(cyc - ref->second);
+				cyc = ref->second;
+			}
+			fprintf(g_log, "R %06x %llu v0=%08x v1=%08x f0=%08x writes=%llu hash=%016llx clobbered=%03x cyc=%lld\n",
+				fr.func - g_base, (unsigned long long)fr.call, currentMIPS->r[MIPS_REG_V0], currentMIPS->r[MIPS_REG_V1],
+				currentMIPS->fi[0], (unsigned long long)fr.writes, (unsigned long long)fr.hash, clobbered, (long long)cyc);
+			g_frames.erase(g_frames.begin() + k);
+		}
+		break;
+	}
+	if (pc >= g_lo && pc <= g_hi && g_watch[(pc - g_lo) / 4] && !currentMIPS->inDelaySlot) {
+		u64 call = g_calls[pc]++;
+		const u32 *r = currentMIPS->r;
+		const u32 *fi = currentMIPS->fi;
+		fprintf(g_log, "E %06x %llu t=%d a0=%08x a1=%08x a2=%08x a3=%08x t0=%08x t1=%08x f12=%08x f13=%08x f14=%08x f15=%08x\n",
+			pc - g_base, (unsigned long long)call, thread, r[4], r[5], r[6], r[7], r[8], r[9], fi[12], fi[13], fi[14], fi[15]);
+		Frame fr{pc, r[MIPS_REG_RA], r[MIPS_REG_SP], thread, call, 0, 0, {}, (s64)CoreTiming::GetTicks()};
+		for (int i = 0; i < 9; i++) fr.saved[i] = r[i < 8 ? 16 + i : 30];
+		g_frames.push_back(fr);
+	}
+	g_tracing = !g_frames.empty();
+}
+
+void OnWrite(u32 addr, u64 value, int size) {
+	int thread = __KernelGetCurThread();
+	for (Frame &fr : g_frames) {
+		// a call's own stack frame (and its callees') lies just below the caller's sp: its layout
+		// is the compiler's business, so those writes are not behaviour
+		if (fr.thread == thread && !(addr < fr.sp && addr >= fr.sp - 0x40000)) {
+			fr.hash = Mix(Mix(Mix(fr.hash, addr), value), size);
+			fr.writes++;
+		}
+	}
+}
+}
diff --git a/Core/RRBox.h b/Core/RRBox.h
new file mode 100644
index 0000000..f217fee
--- /dev/null
+++ b/Core/RRBox.h
@@ -0,0 +1,21 @@
+// rrbox: per-function call tracing for the Ridge Racer decomp's A5 oracle.
+// Watched functions log their arguments at entry and, at return, their return registers plus a
+// hash of every memory write made during the call (callees included), on the calling thread only.
+#pragma once
+#include <cstdio>
+#include <vector>
+#include "Common/CommonTypes.h"
+
+namespace RRBox {
+extern bool g_tracing;                  // any watched call active: memory writes are hashed
+void Load(const char *watchFile, const char *logFile, u32 moduleBase);
+// Candidate runs: give each watched call exactly the emulated time it took in retail.
+void LoadCycleRef(const char *retailCallLog);
+// Write instruction coverage of the watched functions (lines: offset size executed-words).
+void Finish();
+// Fault injection: the Nth call (0-based) of system function NAME returns VALUE instead.
+void AddForce(const char *name, int n, u32 value);
+void OnSyscallReturn(const char *name);   // after the HLE function ran, before any thread switch
+void OnPC(u32 pc);                      // before each interpreted instruction
+void OnWrite(u32 addr, u64 value, int size);
+}
